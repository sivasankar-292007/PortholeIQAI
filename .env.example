# =====================================================================
# POTHOLEIQ ENVIRONMENT CONFIGURATION (.env.example)
# =====================================================================
# Rename this file to .env and provide your project keys.
# When Firebase keys are blank, PotholeIQ runs in resilient local demo mode.

# ---------------------------------------------------------------------
# 1. Firebase Web SDK Configuration
# Source: Firebase Console > Project Settings (gear icon) > General > Your apps > Web app
# ---------------------------------------------------------------------
# Required for Firebase Authentication, Cloud Firestore, and Cloud Storage:
VITE_FIREBASE_API_KEY=""
VITE_FIREBASE_AUTH_DOMAIN=""
VITE_FIREBASE_PROJECT_ID=""
VITE_FIREBASE_STORAGE_BUCKET=""
VITE_FIREBASE_MESSAGING_SENDER_ID=""
VITE_FIREBASE_APP_ID=""

# ---------------------------------------------------------------------
# 2. Municipal Dispatch Configuration (Server-Side Secrets)
# ---------------------------------------------------------------------
# Configured in Settings -> Secrets (never exposed in client code):
EMAIL_API_KEY=""
MUNICIPAL_EMAIL=""
VITE_MUNICIPAL_OFFICE_EMAIL="potholes-response@smartcity.gov"

# ---------------------------------------------------------------------
# 3. Optional Maps & AI Integrations
# ---------------------------------------------------------------------
# Google Maps Platform JavaScript API Key (Optional - OpenStreetMap Leaflet active by default)
VITE_GOOGLE_MAPS_API_KEY=""

# Gemini API Key (Optional - for advanced civil multimodal structural road damage assessments)
GEMINI_API_KEY=""

# Hosted app URL (auto-injected in production environments)
APP_URL=""
